# ============================================================
# .gitignore for AKS Observability Demo
# ============================================================

# ===========================
# Terraform Files
# ===========================
# Local .terraform directories
**/.terraform/*

# Terraform state files - NEVER commit these (contain secrets)
*.tfstate
*.tfstate.*
*.tfstate.backup
terraform.tfstate
terraform.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (may contain sensitive data)
*.tfvars
*.tfvars.json

# Ignore override files (local customizations)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock files (optional - some teams commit this, some don't)
# Uncomment if you want to ignore lock files:
# .terraform.lock.hcl

# ===========================
# Kubernetes Secrets
# ===========================
# Never commit actual secrets (the template is OK)
secrets.yaml
*-secret.yaml
!*-secret.yaml.template
!app-insights-secret.yaml

# Kubeconfig files
kubeconfig
*.kubeconfig
.kube/

# ===========================
# Azure CLI & Credentials
# ===========================
.azure/
*.publishsettings
*.azureauth

# ===========================
# Node.js (Order Service)
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity
.env
.env.local
.env.*.local

# ===========================
# Java (Product Service)
# ===========================
target/
*.class
*.jar
*.war
*.ear
*.log
.classpath
.project
.settings/
*.iml
.idea/
*.iws
*.ipr

# Maven
.mvn/
mvnw
mvnw.cmd

# ===========================
# Python (Recommendation/Shipping Services)
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
ENV/
env/
.venv
pip-log.txt
pip-delete-this-directory.txt

# ===========================
# Docker
# ===========================
.dockerignore

# ===========================
# IDE & Editor Files
# ===========================
# VSCode
.vscode/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ===========================
# OS Files
# ===========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.Trash-*

# ===========================
# Logs & Temporary Files
# ===========================
*.log
*.tmp
*.temp
*.cache
.cache/
logs/

# ===========================
# Backup Files
# ===========================
*.bak
*.backup
*.old
*.orig

# ===========================
# Application Specific
# ===========================
# OpenTelemetry Collector local data
otel-collector-data/

# H2 Database files (Product Service)
*.db
*.mv.db
*.trace.db

# Test coverage reports
coverage/
.nyc_output/
*.lcov

# ===========================
# CI/CD Artifacts
# ===========================
.github/workflows/*.secrets
